# Copy to .env.local for local development (never commit .env.local).
# These values come from Firebase console → Project settings → Your apps → Web app.
# They are PUBLIC by design (they ship inside the JS bundle). Security comes from firestore.rules.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Only needed when building for GitHub Pages by hand; the workflow sets it automatically.
# VITE_BASE_PATH=/your-repo-name/
