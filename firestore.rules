rules_version = '2';

// Each signed-in user can read and write ONLY their own data under users/{uid}/...
// Everything else is denied. The Firebase web config is public; these rules are the security.
service cloud.firestore {
  match /databases/{database}/documents {

    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    match /users/{uid} {
      allow read, write: if isOwner(uid);

      match /{collection}/{docId} {
        allow read, write: if isOwner(uid)
          && collection in ['settings', 'exercises', 'plans', 'workouts', 'bodyLogs', 'habitLogs'];
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
